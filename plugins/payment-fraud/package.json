{
	"name": "@mamir/plugin-payment-fraud",
	"version": "0.1.0",
	"private": true,
	"description": "MAMIR domain plugin: card payment fraud (IEEE-CIS)",
	"author": "Nikita MRCS",
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts --clean",
		"dev": "tsup src/index.ts --format cjs,esm --dts --watch"
	},
	"dependencies": {
		"@mamir/contracts": "*"
	},
	"devDependencies": {
		"tsup": "^8.5.1",
		"zod": "^4.4.3"
	}
}

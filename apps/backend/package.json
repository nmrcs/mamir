{
	"name": "@mamir/backend",
	"version": "0.1.0",
	"private": true,
	"description": "MAMIR core: ingest, point-in-time features, scoring, exposure, backtest",
	"author": "Nikita MRCS",
	"license": "MIT",
	"scripts": {
		"prebuild": "prisma generate",
		"build": "nest build",
		"start": "nest start",
		"predev": "prisma generate; lsof -ti:3001 | xargs kill -9 2>/dev/null; true",
		"dev": "nest start --watch",
		"start:prod": "node dist/main",
		"prisma:migrate": "prisma migrate dev",
		"prisma:reset": "prisma migrate reset",
		"ingest": "node dist/ingest/ingest.cli.js",
		"preingest": "nest build",
		"prewindows": "nest build",
		"windows": "node dist/windows/windows.cli.js",
		"prebacktest": "nest build",
		"backtest": "node dist/backtest/backtest.cli.js",
		"prebench": "nest build",
		"bench": "node dist/events/bench.cli.js",
		"test": "TZ=Asia/Tokyo node --import tsx --test --test-concurrency=1 test/*.test.ts"
	},
	"dependencies": {
		"@mamir/contracts": "*",
		"@nestjs/common": "^11.1.0",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^11.1.0",
		"@nestjs/platform-express": "^11.1.0",
		"@nestjs/swagger": "^11.4.0",
		"@prisma/adapter-pg": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"csv-parse": "^7.0.1",
		"pg": "^8.22.0",
		"pg-copy-streams": "^7.0.0",
		"reflect-metadata": "^0.2.2",
		"undici": "^8.10.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@types/express": "^5.0.0",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.16.0",
		"@types/pg-copy-streams": "^1.2.5",
		"dotenv": "^17.0.0",
		"prisma": "^7.9.0",
		"tsx": "^4.19.0"
	}
}
